# ==========================================
# Veluntu SaaS Configuration Template
# ==========================================
NODE_ENV=development
PORT=5000

# Supabase API Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection (Supabase PostgreSQL or Local)
# Option A: Connection string (recommended for poolers)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres?sslmode=require

# Option B: Individual parameters
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=true

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# URLs
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api
